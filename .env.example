# Copy to `.env` (gitignored) before enabling optional profiles.

# Cloudflare Tunnel (DoD #7) — docker compose --profile tunnel up -d
# Create a tunnel in Zero Trust, then paste the token:
TUNNEL_TOKEN=

# Optional: standalone app secrets when not exporting them in the shell
# APP_SECURITY_ENABLED=true
# APP_ADMIN_USER=admin
# APP_ADMIN_PASSWORD=changeme
# APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# DB_PATH=./data/office.db
